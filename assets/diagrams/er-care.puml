@startuml
title ER · Care / seguimiento
caption Persistencia inferida del paciente, mediciones, alertas e intervenciones
skinparam shadowing false
entity "patients" as patients {
  PK id VARCHAR(255)
  given_name, family_name, family_display_name
  age INTEGER; version BIGINT
  location, provider_id, user_id
}
entity "patient_family_ids" as families {
  FK patient_id → patients.id
  family_ids VARCHAR(255)
  Tabla implícita de @ElementCollection.
}
entity "care_alerts" as alerts {
  PK id VARCHAR(255)
  patient_id, record_id, type
  severity y status: enum por nombre
  raised_at temporal; version BIGINT
}
entity "interventions" as interventions {
  PK id VARCHAR(255)
  alert_id, actor_id, actor, role
  from_status / to_status: enum por nombre
  intervened_at temporal; note VARCHAR(2000)
}
entity "clinical_records" as records {
  PK id VARCHAR(255)
  patient_id, type, unit, origin
  value_text, note VARCHAR(2000)
  numeric_value BOOLEAN; recorded_at temporal
  provider_id, provider_name
}
entity "measurement_ranges" as ranges {
  PK id VARCHAR(255); unit VARCHAR(255)
  Rangos normales, críticos y de presión: DOUBLE
}
patients --> families : Colección JPA, paciente 1 a 0..* identificadores familiares.
patients ..> alerts : patient_id lógico: paciente 1 a 0..* alertas.
alerts ..> interventions : alert_id lógico: alerta 1 a 0..* intervenciones.
alerts ..> records : record_id lógico: alerta con 0..1 medición asociada.
legend bottom
La colección tiene un vínculo ORM con patients; sus valores de texto no referencian físicamente a users.
endlegend
@enduml
