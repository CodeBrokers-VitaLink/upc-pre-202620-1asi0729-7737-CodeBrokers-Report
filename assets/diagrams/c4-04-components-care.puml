@startuml
!include <C4/C4_Component>
title C4 · SPA / Care
caption Web Application Angular · paneles y seguimiento
skinparam shadowing false
Component(workspace, "CareWorkspace", "Angular", "Paneles, fichas, listas de alertas y resumen.")
Component(notes, "Observations / Notifications", "Angular", "Registro, lectura y seguimiento de observaciones y avisos.")
Component(store, "CareStore", "Signals y RxJS", "Carga datos, filtra y coordina las transiciones.")
Component(adapter, "ObservationsHttpService", "HttpClient", "Realiza consultas y comandos por OBSERVATIONS_PORT.")
Component(care, "CareService", "HttpClient", "Adapta pacientes, mediciones y alertas al modelo de UI.")
System_Ext(obsApi, "REST API / Observations", "/patients/{id}/observations y /notifications.")
System_Ext(api, "REST API / Care", "Recursos de cuidado y transiciones de alerta.")
Rel(workspace, store, "Las vistas se suscriben al estado de cuidado.")
Rel(notes, adapter, "Las vistas usan el puerto de observaciones.")
Rel(store, care, "Envía operaciones y usa los assemblers de infraestructura.")
Rel(adapter, obsApi, "HTTPS / JSON y bearer.")
Rel(care, api, "HTTPS / JSON y bearer.")
@enduml
